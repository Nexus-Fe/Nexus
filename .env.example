API_GATEWAY_URL=http://localhost:8080

# GHN Master Data Fetcher Configuration (Chỉ dùng trên máy phát triển khi chạy npm run fetch:address)
# Tuyệt đối KHÔNG thêm tiền tố NEXT_PUBLIC_ để tránh lộ token ra frontend
GHN_TOKEN=your_ghn_token_here
GHN_ENV=prod # "prod" (online-gateway.ghn.vn) hoặc "dev" (dev-online-gateway.ghn.vn)
